      ["mind", "PHOEUPBD"], ["best", "PWEFT"], ["castle", "KAFL"], ["lesson", "HR-FPB"], ["bank", "PWA*PBG"], ["silk", "S*EULG"],
      ["help", "HEP"], ["nation", "TPH-GS"], ["car", "KAR"], ["far", "TPAR"], ["more", "PHOR"], ["hair", "HAEUR"],
      ["care", "KAEUR"], ["beer", "PWAOER"], ["fire", "TPAOEUR"], ["hurt", "HURT"], ["girl", "TKPWEURL"], ["bird", "PWEURD"]
    ]
  }
