    { "t": "h", "x": "More every day" },
    { "t": "table", "head": ["Word", "Stroke", "Word", "Stroke", "Word", "Stroke"], "rows": [
      ["{{there}}", "[[there|THR]]", "{{their}}", "[[their|THAER]]", "{{then}}", "[[then|THEB]]"],
